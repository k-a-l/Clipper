# Clipper settings. Copy this file to ~/Clipper/.env (or to the folder you run `clipper` from)
# and fill in what you need. Everything is optional: with an empty file Clipper starts, and you
# add streams and accounts from the dashboard (`clipper ui --open`).
# Full credential walkthrough: docs/CREDENTIALS.md

# --- Where data goes ----------------------------------------------------------
# CLIPPER_HOME=~/Clipper            # settings + data folder (set as an environment variable)
# STORAGE_DIR=~/Clipper/storage      # recordings, clips, state, encrypted tokens

# --- Encryption key for saved logins (REQUIRED before connecting any account) ---
# Generate one with:  clipper gen-key
TOKEN_ENCRYPTION_KEY=

# --- YouTube uploads (Google Cloud OAuth client, type "Desktop app") -----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Start private, check a few uploads, then switch to public.
YOUTUBE_PRIVACY_STATUS=private

# --- Facebook Reels (Meta app + a Page you manage) ------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
# DRAFT until you've reviewed output, then PUBLISHED.
FACEBOOK_VIDEO_STATE=DRAFT

# --- Twitch app (only for the Discover panel) -------------------------------------
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# --- Posting pace (per platform) ---------------------------------------------
PUBLISH_PLATFORMS=["youtube","facebook"]
MAX_POSTS_PER_DAY=3
MIN_POST_SPACING_MINUTES=180

# --- Live streams to watch (you can also add them in the dashboard) -----------
# permission_confirmed=true ONLY for content you own or have permission to repost;
# other sources are clipped locally but never published.
# SOURCES='[{"platform":"twitch","channel":"yourchannel","signals":["chat","audio"],"permission_confirmed":true},
#           {"platform":"youtube","url":"https://www.youtube.com/@NASA/live","display_name":"NASA","signals":["audio"]}]'

# --- Tools (defaults use whatever is on PATH) ------------------------------------
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# JS_RUNTIME=node                   # yt-dlp needs node or deno for YouTube

# --- Optional local AI (see docs/OPTIONAL_AI.md) ---------------------------------
# STORY_LLM=true                    # AI hooks/titles via Ollama (falls back to templates if not running)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_VISION_MODEL=qwen3-vl:8b

# --- Quality / length ------------------------------------------------------------
# VOD_MAX_HEIGHT=4320               # highest source resolution to download (lower to save disk)
# RANDOM_CLIP_MIN_S=30
# RANDOM_CLIP_MAX_S=90
